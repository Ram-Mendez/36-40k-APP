@baseUrl = http://localhost:8086

### Sign in and save tokens (IntelliJ HTTP Client)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"username":"operations","password":"DevPassword123!"}

> {% client.global.set("accessToken", response.body.accessToken); client.global.set("refreshToken", response.body.refreshToken); %}

### List active customers
GET {{baseUrl}}/api/v1/customers?active=true&page=0&size=20&sort=name&direction=asc
Authorization: Bearer {{accessToken}}

### Search the catalog by SKU
GET {{baseUrl}}/api/v1/products?active=true&search=GLOVE-100
Authorization: Bearer {{accessToken}}

### Create an order using the sample customer ID
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"customerId":1}

> {% client.global.set("orderId", response.body.id); %}

### Add or update an order line
PUT {{baseUrl}}/api/v1/orders/{{orderId}}/lines/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"quantity":2}

### Confirm the order and reserve stock
POST {{baseUrl}}/api/v1/orders/{{orderId}}/confirm
Authorization: Bearer {{accessToken}}
X-Request-ID: manual-confirm-001

### View active reservations
GET {{baseUrl}}/api/v1/inventory/reservations
Authorization: Bearer {{accessToken}}

### Complete the order and record the stock movement
POST {{baseUrl}}/api/v1/orders/{{orderId}}/complete
Authorization: Bearer {{accessToken}}
X-Request-ID: manual-complete-001

### Check the order status
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

### View stock movements
GET {{baseUrl}}/api/v1/inventory/movements?productId=1&page=0&size=20
Authorization: Bearer {{accessToken}}

### View completed sales
GET {{baseUrl}}/api/v1/reports/sales?page=0&size=20
Authorization: Bearer {{accessToken}}

### Refresh the session tokens
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{"refreshToken":"{{refreshToken}}"}

> {% client.global.set("accessToken", response.body.accessToken); client.global.set("refreshToken", response.body.refreshToken); %}

### Sign out
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{accessToken}}

### Check application health
GET {{baseUrl}}/actuator/health
